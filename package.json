{
  "name": "dahamkke-classroom-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm --prefix apps/web run build",
    "dev": "npm --prefix apps/web run dev",
    "start": "npm --prefix apps/web run start",
    "check-types": "npm run --workspaces check-types --if-present"
  }
}
